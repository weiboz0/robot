# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alibaba DashScope (Qwen)
DASHSCOPE_CODING_KEY=

# Volcano Engine ARK — inference key (chat/completions)
ARK_API_KEY=

# OpenCode (OpenAI-compatible)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=minimax-m3

# Force a provider (ark | dashscope | opencode). Blank = auto-detect.
PROVIDER=opencode

# Model per provider. For ARK, a foundation-model id or an inference endpoint (ep-...).
ARK_MODEL=
DASHSCOPE_MODEL=

# Volcano account AccessKey/SecretKey — only for list_ark_endpoints.py
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
